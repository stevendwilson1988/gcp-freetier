# Never commit GCP credentials or keys
*.pem
*.key
*.p12
id_*
.env
# Service account key files (prefer `gcloud auth login` / ADC over key files)
*-key.json
*credentials*.json
service-account*.json
sa-*.json

# OpenTofu: state holds instance details and IPs; tfvars hold project and your IP prefix
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
